# ========================================================
# CONFIGURACIÓN DE PRODUCCIÓN - DATEC LIBRO DE RECLAMACIONES
# ========================================================

# 1. Configuración de la Aplicación
APP_NAME="Datec Libro"
APP_ENV=production
# Genera tu clave con: docker compose run --rm app php artisan key:generate --show
APP_KEY=base64:dz3MHKe4JK00fFicKfLFa1+hHEPyA6136SO+lkrTPKU=
APP_DEBUG=false
# URL oficial con HTTPS donde accederán los consumidores y administradores
APP_URL=https://libro.datec.pe
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Puerto HTTP en el host donde se publicará la app (para conectar a Nginx Proxy Manager o Caddy)
APP_PORT=8080

# 2. Base de Datos PostgreSQL en Docker
DB_CONNECTION=pgsql
# IMPORTANTE: En Docker el host es el nombre del servicio 'db'
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dateclibro
DB_USERNAME=postgres
# Coloca una contraseña segura para tu base de datos en producción
DB_PASSWORD=CambiaEstaContrasenaPorUnaSegura2026!
# Puerto opcional expuesto en el host (cámbialo si 5435 está ocupado en tu servidor)
DB_PORT_EXTERNAL=5435

# 3. Sesiones y Caché
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# 4. Logs de Producción
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# 5. Envío de Correos Oficiales (Constancias a Consumidores y Notificaciones)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@datec.pe"
MAIL_FROM_NAME="Libro de Reclamaciones Datec"

# 6. Alertas Administrativas Internas
DATEC_ALERTAS_EMAIL=alertas@datec.pe

# 7. Integración y API Pública
API_PUBLICA_HABILITADA=false

